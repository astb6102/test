#include "cla_shared.h"
#include "device.h"
#include "f28003x_device.h"

__interrupt void Cla1Task1(void)
{
    // 1. SPI 엔코더 읽기 명령 송신 (더미 데이터 쓰기)
    // SPIB 기준 예시이며, 실제 보드의 SPI 베이스 레지스터에 맞추어 변경하세요.
    SpibRegs.SPITXBUF = 0x0000; 

    // 2. SPI 수신 버퍼에 데이터가 찰 때까지 대기 (CLA 백그라운드 블로킹)
    while(SpibRegs.SPIFFRX.bit.RXFFST == 0);

    // 3. 데이터 읽기 및 마스킹 (예: 13비트 엔코더 스케일링)
    uint32_t raw_data = SpibRegs.SPIRXBUF;
    uint32_t enc_val = (raw_data >> 2) & 0x1FFF; // 기존 소스의 마스킹 방식 적용

    // 4. 결과를 Message RAM에 저장
    ClaToCpu.encoder_raw = enc_val;
    ClaToCpu.position_deg = (float)enc_val / 8191.0f * 360.0f;

    ClaToCpu.isr_tick++;
}